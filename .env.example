# Copy to .env (git-ignored) and fill in. Never commit real secrets (§5).
# On the Pi the complete .env is kept in Bitwarden as "Meal Planner .env".

# ── HTTP ──────────────────────────────────────────────────────────────────────
PORT=3000
# Public HTTPS URL of the MCP surface (used in OAuth metadata for claude.ai).
BASE_URL=https://mcp.winterbottom.xyz/meals
# Log timestamps only — week logic always uses Europe/Zurich regardless of TZ.
TZ=Europe/Zurich

# ── Data ──────────────────────────────────────────────────────────────────────
MEALS_DB=/data/meals.db

# ── MCP auth ──────────────────────────────────────────────────────────────────
# x-api-key for Claude Code / MCP Inspector. Required, ≥32 chars: openssl rand -hex 32
MCP_API_KEY=
# Static OAuth client (optional — claude.ai registers itself dynamically).
# openssl rand -hex 16 / openssl rand -hex 32
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Password typed on the OAuth consent page when connecting claude.ai.
# Unset = every OAuth approval is refused (x-api-key still works).
OAUTH_APPROVAL_PASSWORD=
# Access token lifetime in hours (default 168 = 7 days).
OAUTH_TOKEN_TTL_H=168

# ── Planning rules ───────────────────────────────────────────────────────────
# Titles of the Flatnotes notes Claude is told to read. The app never calls
# Flatnotes; these are the defaults (see docs/seed-flatnotes-rules.md).
MEALS_RULE_NOTE_HOUSEHOLD=Meals - Household
MEALS_RULE_NOTE_MEAL_BANK=Meals - Meal Bank
MEALS_RULE_NOTE_RECIPES=Meals - Recipes
MEALS_RULE_NOTE_PANTRY=Meals - Pantry

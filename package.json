{
  "name": "meal-planner",
  "version": "0.3.0",
  "description": "Family meal planner: phone web viewer plus an MCP server so Claude can plan, save and read our weekly meal plans.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:vendor": "node --test src/vendor/oauth2-authorization-server.test.js",
    "start": "node src/index.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "1.56.1",
    "@vitest/coverage-v8": "^2",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3",
    "vitest": "^2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
